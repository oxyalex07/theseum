{
  "name": "theseus-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Theseus desktop agent orchestration foundation",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pty.mjs",
    "test:routines": "node tests/routines-electron.mjs",
    "test:research": "node tests/research-electron.mjs",
    "test:composer-context": "node tests/composer-context-electron.mjs",
    "test:project-tools": "node tests/project-tools-electron.mjs",
    "test:project-platform": "node tests/project-platform-electron.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "node scripts/dev-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:electron",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "test": "vitest run",
    "audit:dependencies": "pnpm audit --audit-level=low",
    "test:electron-runtime": "node tests/electron-runtime.mjs",
    "test:desktop": "node tests/desktop-electron.mjs",
    "test:desktop-zoom": "node tests/desktop-zoom.mjs",
    "test:continuation": "node tests/continuation-electron.mjs",
    "test:history": "node tests/history-electron.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:contrast": "node tests/text-contrast.mjs",
    "test:crew": "node tests/crew-electron.mjs",
    "test:concurrency": "node tests/concurrency-electron.mjs",
    "test:agent": "node tests/agent-electron.mjs",
    "test:profile-lifecycle": "node tests/profile-lifecycle-electron.mjs",
    "test:profiles": "node tests/profiles-electron.mjs",
    "test:launchers": "node tests/launchers-electron.mjs",
    "test:github-agents": "node tests/github-agents-electron.mjs",
    "test:memory-workflows": "node tests/memory-workflows-electron.mjs",
    "test:memory": "node tests/memory-electron.mjs",
    "test:settings-memory": "node tests/settings-memory-electron.mjs",
    "test:samples": "node tests/sample-preview.mjs",
    "test:topbar": "node tests/topbar-electron.mjs",
    "test:notifications": "node tests/notifications-electron.mjs",
    "test:resources": "node tests/resources-electron.mjs",
    "test:library": "node tests/library-electron.mjs",
    "test:safety": "node tests/safety-electron.mjs",
    "test:terminal": "node tests/terminal-electron.mjs",
    "test:browser": "node tests/browsing-electron.mjs",
    "test:connections": "node tests/connections-electron.mjs",
    "test:git": "node tests/git-electron.mjs",
    "test:worktrees": "node tests/worktrees-electron.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.59.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "electron": "44.10.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.9.1"
}
